# ====================================================================
# BIẾN MÔI TRƯỜNG MẪU - HỆ THỐNG QUẢN LÝ BÁO GIÁ THILOGI
# Sao chép tệp này thành .env trên VPS và điền mật khẩu bí mật của bạn:
#   cp .env.example .env && nano .env
# ====================================================================

# 1. Cấu hình CSDL PostgreSQL (Container thilogi-postgres)
POSTGRES_USER=thilogi_admin
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=thilogi_db

# Chuỗi kết nối Database cho Next.js bên trong mạng Docker:
# Lưu ý: Mật khẩu trong DATABASE_URL phải khớp với POSTGRES_PASSWORD ở trên
DATABASE_URL=postgres://thilogi_admin:your_strong_postgres_password_here@postgres:5432/thilogi_db

# 2. Khóa bí mật ký Token xác thực người dùng (JWT Secret)
# Chuỗi ngẫu nhiên tối thiểu 32-64 ký tự (ví dụ: tạo bằng `openssl rand -hex 32`)
JWT_SECRET=your_super_secure_random_jwt_secret_key_here

# 3. Cấu hình ứng dụng
NODE_ENV=production
PORT=3000

# Chỉ bật trên môi trường thử nội bộ: cho phép chọn tài khoản không cần mật khẩu.
# Không còn tự đăng nhập bằng tài khoản đầu tiên. Mặc định đăng nhập bằng users.password_hash (bcrypt).
ENABLE_DEMO_AUTH=false

